# ==============================================================================
# Universal AI Quantization Engine (UAQE) - .gitignore
# ==============================================================================

# Python bytecode, compilations, and caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing and Quality Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.gemini/

# Node.js & Frontend Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# UAQE Runtime Outputs & Job History (Automatically recreated on startup)
output/
scratch/
archive/
src/output/
src/outputs/
src/logs/
src/reports/
src/scratch/
*.log

# ── CI Regression Test Fixtures ──────────────────────────────────────────────
# The two historical job directories below are authoritative regression fixtures
# required by the backend test suites in tests/. They must be committed so that
# GitHub Actions (clean checkout) can run the tests without a live UAQE run.
# Large dataset images (inputs/) and redundant model_fp32.onnx are excluded.
!output/
!output/jobs/
!output/jobs/UAQE-20260909-131603-5C90DE51/
!output/jobs/UAQE-20260909-131603-5C90DE51/**
output/jobs/UAQE-20260909-131603-5C90DE51/inputs/
output/jobs/UAQE-20260909-131603-5C90DE51/model_fp32.onnx
!output/jobs/UAQE-20260909-191140-11AA370D/
!output/jobs/UAQE-20260909-191140-11AA370D/**
output/jobs/UAQE-20260909-191140-11AA370D/inputs/
output/jobs/UAQE-20260909-191140-11AA370D/model_fp32.onnx
# Standalone XNNPACK model used by test_candidate_latency_provenance.py (test 13)
!output/phase_xnnpack/
!output/phase_xnnpack/models/
!output/phase_xnnpack/models/mobilenetv3_sem_9class_xnnpack_int8.tflite

# Sensitive environment configuration & secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
*.crt

# Large raw datasets and archives (Manifests & small calibration sets retained)
datasets/raw/
datasets/*.tar
datasets/*.tar.gz
datasets/*.zip
datasets/imagenet*/

# Models Policy: Keep verified demonstration models, exclude temporary conversion files
models/temp/
*.tmp
